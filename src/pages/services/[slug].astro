---
// ROUTE B: /services/:slug. Uses src/content/pages/services/<slug>.md when
// there is one; otherwise the short service summary (noindexed).
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import DynamicHero from '@/components/DynamicHero.jsx';
import LeadCaptureForm from '@/components/LeadCaptureForm.jsx';
import { services, extraServices, cities, pageTitle, breadcrumbSchema, extractFaqs, faqSchema } from '@/lib/site.js';

export async function getStaticPaths() {
  const articles = await getCollection('pages');
  return [...services, ...extraServices]
    .filter((s) => s.slug !== 'wildlife-control')
    .map((service) => ({
      params: { slug: service.slug },
      props: { service, article: articles.find((a) => a.data.path === `/services/${service.slug}`) },
    }));
}

const { service, article } = Astro.props;
const site = Astro.site.origin;
const coreTitle = article?.data.meta_title ?? service.name;
const description =
  article?.data.meta_description ??
  `Expert ${service.name.toLowerCase()} services. Fast, experienced, and locally owned technicians ready to help.`;
const { Content } = article ? await render(article) : { Content: null };
const faqs = article ? extractFaqs(article.body) : [];
const featuredCities = cities.filter((c) => !c.isHub && c.province === 'on');
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    serviceType: service.name,
    provider: { '@id': `${site}/#business` },
    areaServed: 'CA',
    url: `${site}/services/${service.slug}`,
  },
  breadcrumbSchema(site, [['Home', '/'], ['Services', '/services/wildlife-control'], [service.name, `/services/${service.slug}`]]),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];
---
<Base title={pageTitle(coreTitle)} description={description} schema={schema}>
  <DynamicHero
    eyebrow={service.category || 'Core Service'}
    eyebrowIcon="service"
    title={article?.data.title ?? service.name}
    description={description}
    imageSrc={article?.data.hero_image}
  />

  <section class="mx-auto max-w-[72rem] px-6 py-16 sm:py-24">
    {Content ? (
      <div class="prose max-w-none"><Content /></div>
    ) : service.baseContent ? (
      <div class="prose max-w-none"><Fragment set:html={service.baseContent} /></div>
    ) : (
      <p class="mt-8 max-w-2xl text-lg text-stone-600">
        Our trained technicians handle {service.name.toLowerCase()} safely and effectively, with same-day appointments available in most areas.
      </p>
    )}

    {services.some((s) => s.slug === service.slug) && (
      <div class="mt-12 rounded-2xl border border-stone-200 bg-white p-6">
        <p class="text-sm font-bold text-stone-900">{service.name} near you</p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-3">
          {featuredCities.map((c) => (
            <li><a href={`/${c.province}/${c.slug}/${service.slug}`} class="text-sm text-stone-600 transition hover:text-emerald-700">{service.name} in {c.name}</a></li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <LeadCaptureForm
    client:visible
    title={`Request ${service.name}`}
    description={`Share a few details and a local, experienced technician will call you back about ${service.name.toLowerCase()} — usually the same day.`}
    serviceSlug={service.slug}
    serviceName={service.name}
  />
</Base>
