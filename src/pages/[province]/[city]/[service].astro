---
// ROUTE C: /:province/:city/:service (one page per city × service).
// Uses the article in src/content/pages/<province>/<city>/<service>.md when
// there is one; otherwise shows the service summary and is noindexed.
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import DynamicHero from '@/components/DynamicHero.jsx';
import heroImages from '@/data/heroImages.json';
import LeadCaptureForm from '@/components/LeadCaptureForm.jsx';
import {
  cities, services, findCity, parentHubOf, pageTitle, breadcrumbSchema, extractFaqs, faqSchema,
  PHONE_DISPLAY, PHONE_TEL, BRAND,
} from '@/lib/site.js';
import { provinceLabel } from '@/lib/formatSlug';

export async function getStaticPaths() {
  const articles = await getCollection('pages');
  const byPath = new Map(articles.map((a) => [a.data.path, a]));
  return cities.flatMap((city) =>
    services.map((service) => ({
      params: { province: city.province, city: city.slug, service: service.slug },
      props: { city, service, article: byPath.get(`/${city.province}/${city.slug}/${service.slug}`) },
    })),
  );
}

const { city, service, article } = Astro.props;
const site = Astro.site.origin;
const prov = provinceLabel(city.province);
const coreTitle = article?.data.meta_title ?? `${service.name} in ${city.name}, ${prov}`;
const h1 = article?.data.title ?? `${service.name} in ${city.name}, ${prov}`;
const description =
  article?.data.meta_description ??
  `Need ${service.name.toLowerCase()} in ${city.name}, ${prov}? Trained local technicians, fast response, and humane, lasting results.`;
const { Content } = article ? await render(article) : { Content: null };
const faqs = article ? extractFaqs(article.body) : [];
const hub = parentHubOf(city);
const path = `/${city.province}/${city.slug}/${service.slug}`;
// Use the article's own hero if it has one, otherwise the city page's hero
const heroImage = article?.data.hero_image ?? heroImages[`/${city.province}/${city.slug}`];
const otherServices = services.filter((s) => s.slug !== service.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${service.name} in ${city.name}, ${prov}`,
    serviceType: service.name,
    provider: { '@id': `${site}/#business` },
    areaServed: { '@type': 'City', name: city.name, containedInPlace: { '@type': 'AdministrativeArea', name: prov } },
    url: site + path,
  },
  breadcrumbSchema(site, [
    ['Home', '/'],
    ...(hub ? [[hub.name, `/${hub.province}/${hub.slug}`]] : []),
    [city.name, `/${city.province}/${city.slug}`],
    [service.name, path],
  ]),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];
---
<Base title={pageTitle(coreTitle)} description={description} schema={schema} image={heroImage}>
  <DynamicHero
    eyebrow={`${service.category || 'Core Service'} · ${city.name}, ${prov}`}
    eyebrowIcon="service"
    title={h1}
    description={description}
    imageSrc={heroImage}
  />

  <section class="mx-auto grid max-w-[72rem] grid-cols-1 gap-10 px-6 py-16 sm:py-24 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
    <div class="min-w-0">
      <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-1 text-sm text-stone-500">
        <a href="/" class="hover:text-emerald-700">Home</a><span>/</span>
        {hub && <><a href={`/${hub.province}/${hub.slug}`} class="hover:text-emerald-700">{hub.name}</a><span>/</span></>}
        <a href={`/${city.province}/${city.slug}`} class="hover:text-emerald-700">{city.name}</a><span>/</span>
        <span class="text-stone-700">{service.name}</span>
      </nav>

      {Content ? (
        <div class="prose max-w-none">
          <Content />
        </div>
      ) : (
        <div class="prose max-w-none">
          <Fragment set:html={service.baseContent} />
          <p>
            Our trained technicians handle {service.name.toLowerCase()} in {city.name} safely and humanely, with
            same-day appointments available in most areas. Share a few details below and a local technician will
            call you back.
          </p>
        </div>
      )}

      <div class="mt-8 flex flex-wrap items-center gap-6 text-sm text-stone-600">
        <span>Same-day availability</span>
        <a href={`tel:${PHONE_TEL}`} class="font-semibold text-emerald-700">{PHONE_DISPLAY}</a>
      </div>

      <a href={`/${city.province}/${city.slug}`} class="mt-8 inline-block text-sm font-semibold text-stone-500 underline-offset-4 hover:text-emerald-700 hover:underline">
        See all services in {city.name} &rarr;
      </a>
    </div>

    <aside class="flex flex-col gap-6 lg:sticky lg:top-28">
      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-bold text-stone-900">Need help now?</p>
        <p class="mt-1 text-sm text-stone-600">Talk to a local {BRAND} technician in {city.name}.</p>
        <a href={`tel:${PHONE_TEL}`} class="mt-4 block rounded-full bg-emerald-700 px-5 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-emerald-800">Call {PHONE_DISPLAY}</a>
        <a href="#lead-capture" class="mt-2 block rounded-full border border-stone-300 px-5 py-2.5 text-center text-sm font-semibold text-stone-700 transition hover:border-emerald-600 hover:text-emerald-700">Get a free quote</a>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-bold text-stone-900">Other services in {city.name}</p>
        <ul class="mt-3 space-y-2">
          {otherServices.map((s) => (
            <li><a href={`/${city.province}/${city.slug}/${s.slug}`} class="text-sm text-stone-600 transition hover:text-emerald-700">{s.name}</a></li>
          ))}
        </ul>
      </div>
    </aside>
  </section>

  <LeadCaptureForm
    client:visible
    title={`Book ${service.name} in ${city.name}`}
    description={`Need ${service.name.toLowerCase()} in ${city.name}, ${prov}? Share a few details and a local, experienced technician will call you back — usually the same day.`}
    serviceSlug={service.slug}
    serviceName={service.name}
    areaName={city.name}
  />
</Base>
