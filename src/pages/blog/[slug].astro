---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import LeadCaptureForm from '@/components/LeadCaptureForm.jsx';
import { services, breadcrumbSchema, extractFaqs, faqSchema, PHONE_DISPLAY, PHONE_TEL, BRAND } from '@/lib/site.js';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, recent: posts.filter((p) => p.id !== post.id).slice(0, 3) },
  }));
}

const { post, recent } = Astro.props;
const { Content } = await render(post);
const site = Astro.site.origin;
const fmt = (d) => d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const words = (post.body || '').split(/\s+/).length;
const readTime = `${Math.max(1, Math.round(words / 200))} min read`;
const faqs = extractFaqs(post.body);
const url = `${site}/blog/${post.id}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    author: { '@type': 'Organization', name: post.data.author },
    publisher: { '@id': `${site}/#business` },
    mainEntityOfPage: url,
    ...(post.data.featured_image ? { image: post.data.featured_image } : {}),
  },
  breadcrumbSchema(site, [['Home', '/'], ['Blog', '/blog'], [post.data.title, `/blog/${post.id}`]]),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];
---
<Base title={`${post.data.meta_title ?? post.data.title} | ${BRAND}`} description={post.data.description} image={post.data.featured_image} schema={schema}>
  <section class="border-b border-stone-200 bg-stone-50">
    <div class="mx-auto max-w-[90rem] px-6 py-10 lg:py-12">
      <div class="grid items-center gap-8 lg:grid-cols-[1fr_420px]">
        <div>
          <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-1 text-sm text-stone-500">
            <a href="/" class="transition hover:text-emerald-700">Home</a><span>›</span>
            <a href="/blog" class="transition hover:text-emerald-700">Blog</a><span>›</span>
            <span class="line-clamp-1 text-stone-700">{post.data.title}</span>
          </nav>
          <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-stone-900 sm:text-4xl lg:text-5xl">{post.data.title}</h1>
          <div class="mt-5 flex flex-wrap items-center gap-5 text-sm text-stone-500">
            <span>{fmt(post.data.date)}</span>
            <span>{readTime}</span>
            <span class="text-stone-400">By {post.data.author}</span>
          </div>
        </div>
        {post.data.featured_image ? (
          <div class="relative aspect-[16/10] overflow-hidden rounded-2xl bg-stone-200 shadow-md">
            <img src={post.data.featured_image} alt={post.data.title} class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="relative flex aspect-[16/10] items-center justify-center overflow-hidden rounded-2xl bg-emerald-50 shadow-md">
            <span class="text-7xl text-emerald-200">🦝</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-[90rem] px-6 py-12 lg:py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_300px] xl:grid-cols-[minmax(0,1fr)_330px]">
      <article class="min-w-0 max-w-none">
        <div class="prose blog-rich-content max-w-none"><Content /></div>
        <div class="mt-10 flex flex-wrap items-center gap-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-6 py-5">
          <div>
            <p class="font-semibold text-stone-900">Heard something last night?</p>
            <p class="text-sm text-stone-600">Call us now — same-day inspections available in most areas.</p>
          </div>
          <a href={`tel:${PHONE_TEL}`} class="ml-auto shrink-0 rounded-full bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-800">{PHONE_DISPLAY}</a>
        </div>
      </article>

      <aside>
        <div class="space-y-6 lg:sticky lg:top-28">
          <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
            <h3 class="mb-4 text-sm font-bold uppercase tracking-widest text-emerald-700">Recent Articles</h3>
            {recent.length === 0 ? <p class="text-sm text-stone-400">No other articles yet.</p> : (
              <ul class="space-y-4">
                {recent.map((art) => (
                  <li>
                    <a href={`/blog/${art.id}`} class="group flex items-start gap-3">
                      <div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-stone-100"><span class="text-xl text-stone-300">🦝</span></div>
                      <div class="min-w-0">
                        <p class="line-clamp-2 text-sm font-semibold leading-snug text-stone-800 transition group-hover:text-emerald-700">{art.data.title}</p>
                        <p class="mt-1 text-xs text-stone-400">{fmt(art.data.date)}</p>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
            <h3 class="mb-4 text-sm font-bold uppercase tracking-widest text-emerald-700">Our Services</h3>
            <ul class="space-y-1.5">
              {services.map((s) => (
                <li><a href={`/services/${s.slug}`} class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm text-stone-700 transition hover:bg-emerald-50 hover:text-emerald-700">› {s.name}</a></li>
              ))}
            </ul>
          </div>
          <div class="rounded-2xl bg-emerald-700 p-6 text-white shadow-md">
            <h3 class="mb-2 text-base font-bold leading-tight">Request an Inspection</h3>
            <p class="mb-5 text-sm leading-relaxed text-emerald-100">Concerned about wildlife activity in your home? Our trained technicians will assess your property and provide a clear action plan.</p>
            <a href="#lead-capture" class="block rounded-full bg-white px-5 py-2.5 text-center text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50">Get a Free Quote</a>
            <a href={`tel:${PHONE_TEL}`} class="mt-3 flex items-center justify-center gap-2 text-sm font-semibold text-emerald-100 transition hover:text-white">{PHONE_DISPLAY}</a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <LeadCaptureForm client:visible />
</Base>
