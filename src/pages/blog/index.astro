---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { breadcrumbSchema } from '@/lib/site.js';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const site = Astro.site.origin;
---
<Base
  title="Blog | Greater Wildlife Control"
  description="Wildlife removal tips, seasonal guides, and expert advice from the Greater Wildlife Control team."
  schema={[breadcrumbSchema(site, [['Home', '/'], ['Blog', '/blog']])]}
>
  <section class="border-b border-stone-200 bg-stone-50">
    <div class="mx-auto max-w-[90rem] px-6 py-10 lg:py-12">
      <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-1 text-sm text-stone-500">
        <a href="/" class="transition hover:text-emerald-700">Home</a><span>›</span><span class="text-stone-700">Blog</span>
      </nav>
      <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-stone-900 sm:text-4xl lg:text-5xl">Wildlife Control Blog</h1>
      <p class="mt-3 text-lg text-stone-600">Tips, guides, and seasonal advice from our expert technicians.</p>
    </div>
  </section>

  <div class="mx-auto max-w-[90rem] px-6 py-12 lg:py-16">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="group flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:shadow-md">
          <div class="aspect-[16/9] overflow-hidden bg-stone-100">
            {post.data.featured_image ? (
              <img src={post.data.featured_image} alt={post.data.title} loading="lazy" class="h-full w-full object-cover transition group-hover:scale-105" />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-emerald-50"><span class="text-4xl text-emerald-300">🦝</span></div>
            )}
          </div>
          <div class="flex flex-1 flex-col p-5">
            <p class="mb-2 text-xs text-stone-400">{fmt(post.data.date)}</p>
            <h2 class="mb-2 line-clamp-2 text-base font-bold leading-snug text-stone-900 transition group-hover:text-emerald-700">{post.data.title}</h2>
            <p class="line-clamp-3 flex-1 text-sm text-stone-500">{post.data.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-emerald-700">Read more ›</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
