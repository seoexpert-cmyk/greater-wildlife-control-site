---
// The Horizons Partner Portal (franchisee login) needed a database. Leads now
// go to franchisees through Make.com, so this page explains that instead.
import Base from '@/layouts/Base.astro';
---
<Base title="Partner Portal | Greater Wildlife Control" description="Information for Greater Wildlife Control franchise partners." noindex>
  <section class="mx-auto max-w-[48rem] px-6 py-24">
    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Franchise partners</p>
    <h1 class="mt-2 text-3xl font-bold text-stone-900">Partner Portal</h1>
    <p class="mt-4 text-stone-600">
      New leads for your territory are sent to you directly by email as soon as they come in.
      If you're a partner and aren't receiving leads, contact us at
      <a href="mailto:contact@greaterwildlifecontrol.ca" class="font-semibold text-emerald-700 hover:underline">contact@greaterwildlifecontrol.ca</a>.
    </p>
  </section>
</Base>
