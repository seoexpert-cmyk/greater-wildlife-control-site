{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "greater-wildlife-control-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-13",
  // Builds the static site before every deploy, whatever build command the
  // Cloudflare dashboard has set.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker runs first on every request so it can send www visitors
    // to the bare domain; everything else falls through to the static files.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "greaterwildlifecontrol.ca", "custom_domain": true },
    { "pattern": "www.greaterwildlifecontrol.ca", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
